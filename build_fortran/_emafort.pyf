!    -*- f90 -*-
! Signature file for wrapping peakfqr routines via f2py.
!
! This file is not optional and it is not merely a filter. Without it f2py
! tries to wrap every public symbol in the sources, including QUADPACK's dqag,
! whose callback wrapper does not compile against current NumPy -- the build
! then fails pointing at generated C rather than at anything in this
! repository. So every symbol exposed here is listed deliberately.
!
! Beyond emafitpr, the routines below exist to give the var_mom port a
! per-routine oracle. Verifying a ported routine only through emafitpr means
! verifying it through the whole EMA fixed point, whose condition number is
! around 1e13 -- a correct routine can look wrong and a wrong one can look
! right. These let each piece be checked against the Fortran directly.
!
! All four are already externally callable by design: peakfqr's own R code
! calls them through .Fortran(), and vendor/peakfqr/R/fortranWrappers.R is the
! reference for their calling conventions. mseg_all_sub and detratsub are
! subroutine wrappers upstream added for exactly this purpose.

python module _emafort
    interface
        subroutine emafitpr(n,ql,qu,tl,tu,dtype,reg_m,reg_m_mse,reg_sd,reg_sd_mse,r_g,r_g_mse,gbthrsh0,pq,nq,eps,wght_opt_n,gbval,gbns,gbnzero,gbnlow,gbp,gbqs,as_g_mse_o,as_g_mse_syst_o,as_g_prl_o,cmoms,yp,ci_low,ci_high,var_est,wdout,qlema,quema,tlema,tuema,nu)
            ! Input variables
            integer, intent(in) :: n
            double precision, dimension(n), intent(in) :: ql
            double precision, dimension(n), intent(in) :: qu
            double precision, dimension(n), intent(in) :: tl
            double precision, dimension(n), intent(in) :: tu
            integer, dimension(n), intent(in) :: dtype
            double precision, intent(in) :: reg_m
            double precision, intent(in) :: reg_m_mse
            double precision, intent(in) :: reg_sd
            double precision, intent(in) :: reg_sd_mse
            double precision, intent(in) :: r_g
            double precision, intent(in) :: r_g_mse
            double precision, intent(in) :: gbthrsh0
            integer, intent(in) :: nq
            double precision, dimension(nq), intent(in) :: pq
            double precision, intent(in) :: eps
            integer, intent(in) :: wght_opt_n

            ! Output variables - MGBT results
            double precision, intent(out) :: gbval
            integer, intent(out) :: gbns
            integer, intent(out) :: gbnzero
            integer, intent(out) :: gbnlow
            double precision, dimension(20000), intent(out) :: gbp
            double precision, dimension(20000), intent(out) :: gbqs

            ! Output variables - skew MSE
            double precision, intent(out) :: as_g_mse_o
            double precision, intent(out) :: as_g_mse_syst_o
            double precision, intent(out) :: as_g_prl_o

            ! Output variables - moments and quantiles
            double precision, dimension(3,3), intent(out) :: cmoms
            double precision, dimension(nq), intent(out) :: yp
            double precision, dimension(nq), intent(out) :: ci_low
            double precision, dimension(nq), intent(out) :: ci_high
            double precision, dimension(nq), intent(out) :: var_est
            double precision, intent(out) :: wdout

            ! Output variables - adjusted data
            double precision, dimension(25000), intent(out) :: qlema
            double precision, dimension(25000), intent(out) :: quema
            double precision, dimension(25000), intent(out) :: tlema
            double precision, dimension(25000), intent(out) :: tuema
            double precision, dimension(25000), intent(out) :: nu
        end subroutine emafitpr

        ! --------------------------------------------------------------- !
        ! Oracles for the var_mom port. See TODO.md P3.                    !
        ! --------------------------------------------------------------- !

        ! Variance-covariance of the moment estimators. The root of the
        ! dependency tree: mse_ema needs it, and so does VAR_EMAB.
        ! nobs/tl/tu describe distinct censoring threshold groups, not
        ! individual observations -- nobs(i) counts the observations sharing
        ! the pair (tl(i), tu(i)).
        subroutine var_mom(nthresh,n_in,tl_in,tu_in,mc_in,varm)
            integer, intent(in) :: nthresh
            double precision, dimension(nthresh), intent(in) :: n_in
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tl_in
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tu_in
            double precision, dimension(3), intent(in) :: mc_in
            double precision, dimension(3,3), intent(out) :: varm
        end subroutine var_mom

        ! MSE of the at-site skew, through whichever at_site_option the
        ! blockdata sets -- ADJE by default, which is the censoring bias
        ! adjustment hydrolib does not yet implement.
        subroutine mseg_all_sub(nthresh,nobs,tl,tu,mc,mseg)
            integer, intent(in) :: nthresh
            double precision, dimension(nthresh), intent(in) :: nobs
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tl
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tu
            double precision, dimension(3), intent(in) :: mc
            double precision, intent(out) :: mseg
        end subroutine mseg_all_sub

        ! The Halloween determinant ratio, Wd. Reached only when the at-site
        ! skew clears 0.04 (emafit.f:763); 0.184 on Cains Coulee.
        subroutine detratsub(mc,n,nthresh,nobs,tl,tu,detratout)
            double precision, dimension(3), intent(in) :: mc
            integer, intent(in) :: n
            integer, intent(in) :: nthresh
            double precision, dimension(nthresh), intent(in) :: nobs
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tl
            double precision, dimension(nthresh), intent(in), depend(nthresh) :: tu
            double precision, intent(out) :: detratout
        end subroutine detratsub

        ! One EMA moment iteration, including the nG*rG regional-skew term.
        ! hydrolib._ema_iteration is a hand transcription of this; wrapping it
        ! turns that from an end-to-end claim into a per-call check.
        subroutine moms_p3(n,ql,qu,rg,ng,mc_old,moms)
            integer, intent(in) :: n
            double precision, dimension(n), intent(in) :: ql
            double precision, dimension(n), intent(in), depend(n) :: qu
            double precision, intent(in) :: rg
            double precision, intent(in) :: ng
            double precision, dimension(3), intent(in) :: mc_old
            double precision, dimension(3), intent(out) :: moms
        end subroutine moms_p3

        ! --------------------------------------------------------------- !
        ! var_mom port, phase 1: the leaf routines it calls directly for  !
        ! p1/p2/p3 and mu_x/e_x (pP3, mP3) and the ones d_est needs       !
        ! (m2p, qP3). m2mn is var_mom's other direct dependency, used to  !
        ! get the noncentral moments mn2mvarb needs. See TODO.md P3.      !
        ! --------------------------------------------------------------- !

        ! Central moments (mu, sigma^2, skew) -> Pearson III shape params
        ! (tau, alpha, beta). Pure algebra -- no blending, no quadrature.
        subroutine m2p(m,p)
            double precision, dimension(3), intent(in) :: m
            double precision, dimension(3), intent(out) :: p
        end subroutine m2p

        ! Central moments -> noncentral (raw) moments about zero.
        subroutine m2mn(m,mn)
            double precision, dimension(3), intent(in) :: m
            double precision, dimension(3), intent(out) :: mn
        end subroutine m2mn

        ! Its inverse: noncentral moments -> central moments.
        subroutine mn2m(mn,m)
            double precision, dimension(3), intent(in) :: mn
            double precision, dimension(3), intent(out) :: m
        end subroutine mn2m

        ! CDF at x of a Pearson III variate with central moments m. Blends
        ! an incomplete-gamma solution with a Wilson-Hilferty normal
        ! approximation, weighted smoothly over |skew| in [0.0007, 0.0010].
        !
        ! Fortran identifiers are case-insensitive and gfortran's symbol
        ! table is all-lowercase; pP3/qP3sub/mP3 must be spelled in lower
        ! case here or the linker looks for a symbol (e.g. qP3sub_) that
        ! does not exist. python sees the lower-case names too.
        function pp3(x,m) result (pp3out)
            double precision, intent(in) :: x
            double precision, dimension(3), intent(in) :: m
            double precision :: pp3out
        end function pp3

        ! Inverse CDF (quantile) of the same distribution. qP3 is itself a
        ! function like pP3, but emafit.f already carries a subroutine
        ! wrapper for it (qP3sub) -- the same one fortranWrappers.R calls.
        subroutine qp3sub(q,m,qP3out)
            double precision, intent(in) :: q
            double precision, dimension(3), intent(in) :: m
            double precision, intent(out) :: qP3out
        end subroutine qp3sub

        ! Expected value of the first n raw moments of a Pearson III variate
        ! between tl and tu, central moments m. Feeds var_mom's mu_x/e_x
        ! (the censored-interval truncated moments hydrolib's own
        ! _truncated_gamma_moment/_truncated_normal_moments approximate).
        subroutine mp3(tl,tu,m,mnout,n)
            double precision, intent(in) :: tl
            double precision, intent(in) :: tu
            double precision, dimension(3), intent(in) :: m
            integer, intent(in) :: n
            double precision, dimension(n), intent(out), depend(n) :: mnout
        end subroutine mp3

        ! --------------------------------------------------------------- !
        ! var_mom port, phase 2: the pieces var_mom sums over each        !
        ! threshold group and combines into the (3,3) covariance matrix   !
        ! -- varb, varc, d_est -- plus expmomderiv, which d_est calls.    !
        ! See TODO.md P3.                                                 !
        ! --------------------------------------------------------------- !

        ! Multinomial-sampling contribution to the covariance of the fitted
        ! moment estimators, from a group with nh observations split
        ! (p1, p2, p3) across (below tl, between tl/tu, above tu). mu_x
        ! packs the three regions' raw moments 1..3 as columns.
        subroutine varb(mu_x,nh,p1,p2,p3,vb)
            double precision, dimension(3,3), intent(in) :: mu_x
            double precision, intent(in) :: nh
            double precision, intent(in) :: p1
            double precision, intent(in) :: p2
            double precision, intent(in) :: p3
            double precision, dimension(3,3), intent(out) :: vb
        end subroutine varb

        ! Within-interval contribution: the extra variance from not knowing
        ! exactly where, inside (tl, tu), a censored observation falls.
        ! e_x packs mP3(tl, tu, mc, 6) -- moments 1..6 of the exact interval,
        ! needed because varc(i,j) reaches e_x(i+j) up to index 6.
        subroutine varc(e_x,nh,p2,vc)
            double precision, dimension(6), intent(in) :: e_x
            double precision, intent(in) :: nh
            double precision, intent(in) :: p2
            double precision, dimension(3,3), intent(out) :: vc
        end subroutine varc

        ! Bias-correction ("D") matrix from the open tails below tl and
        ! above tu, via expmomderiv's Jacobian of E[X^j] with respect to
        ! the fitted noncentral moments. Skipped (zero) on a tail whose
        ! probability is below 1e-6 -- qP3 is not evaluated there either.
        subroutine d_est(nh,mc,pa,pb,d)
            double precision, intent(in) :: nh
            double precision, dimension(3), intent(in) :: mc
            double precision, intent(in) :: pa
            double precision, intent(in) :: pb
            double precision, dimension(3,3), intent(out) :: d
        end subroutine d_est

        ! Jacobian of E[X^j | xmin < X < xmax], j=1..3 (the incomplete-gamma
        ! branch only -- d_est always calls this through m2p, never blended
        ! with Wilson-Hilferty) with respect to the noncentral moments
        ! (m1, m2, m3), via the chain rule through Pearson III params
        ! (tau, alpha, beta): DEXPECT (d E[X^j]/d params) times DPDM
        ! (d params/d moments).
        subroutine expmomderiv(parms,xmin,xmax,jac)
            double precision, dimension(3), intent(in) :: parms
            double precision, intent(in) :: xmin
            double precision, intent(in) :: xmax
            double precision, dimension(3,3), intent(out) :: jac
        end subroutine expmomderiv
    end interface
end python module _emafort
